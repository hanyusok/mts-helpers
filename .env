# ==============================================================================
# 김기중 소아청소년과의원 (mts-helpers) 기본 환경 설정 (.env)
# ==============================================================================
APP_ENV=development

# 서버 바인딩 및 포트 (기본: 3001)
EMR_GATEWAY_HOST=0.0.0.0
EMR_GATEWAY_PORT=3001

# 핫 리로드 (개발 모드: true, 운영 모드: false)
EMR_RELOAD=true
EMR_LOG_LEVEL=info

# 원격 Firebird EMR 진료실 PC 접속 정보
EMR_DB_HOST=192.168.0.12
EMR_DB_PORT=3050
EMR_DB_DIR=C:/mts3/db
EMR_DB_USER=SYSDBA
EMR_DB_PASSWORD=masterkey
