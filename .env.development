# ==============================================================================
# 김기중 소아청소년과의원 (mts-helpers) 개발 환경 설정 (.env.development)
# ==============================================================================
APP_ENV=development

# 개발 서버 포트
EMR_GATEWAY_HOST=0.0.0.0
EMR_GATEWAY_PORT=3001

# 코드 수정 시 자동 핫 리로드 활성화
EMR_RELOAD=true
EMR_LOG_LEVEL=debug

# 원격 Firebird EMR 진료실 PC 접속 정보
EMR_DB_HOST=192.168.0.12
EMR_DB_PORT=3050
EMR_DB_DIR=C:/mts3/db
EMR_DB_USER=SYSDBA
EMR_DB_PASSWORD=masterkey
