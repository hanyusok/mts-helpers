# ==============================================================================
# 김기중 소아청소년과의원 (mts-helpers) 실운영 환경 설정 (.env.production)
# ==============================================================================
APP_ENV=production

# 운영 서버 바인딩 및 포트 (기본: 3001)
EMR_GATEWAY_HOST=0.0.0.0
EMR_GATEWAY_PORT=3001

# 운영 안정성을 위한 리로드 비활성화 및 info 로깅
EMR_RELOAD=false
EMR_LOG_LEVEL=info

# 원격 Firebird EMR 진료실 PC 접속 정보
EMR_DB_HOST=192.168.0.12
EMR_DB_PORT=3050
EMR_DB_DIR=C:/mts3/db
EMR_DB_USER=SYSDBA
EMR_DB_PASSWORD=masterkey
